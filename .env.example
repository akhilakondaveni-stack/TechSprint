# HealthBuddy Configuration
# Copy this file to .env and customize values for your deployment.

# Anthropic Claude API Configuration (Leave blank or set your key. Demo mode is active when key is absent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Security & Symmetric Encryption Key (Fernet 32-byte base64 URL-safe key)
# If blank, the app will automatically generate and persist a local key in data/.fernet.key
FERNET_KEY=

# Local SQLite Database Path
SQLITE_PATH=data/healthbuddy.db

# Application URL
APP_URL=http://localhost:8501

# Telegram Bot Integration (Optional for medicine and appointment notifications)
TELEGRAM_BOT_TOKEN=

# Uploads and limits
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=5
